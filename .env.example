# Ember & Co. frontend environment — copy to .env. NEVER commit .env.
# API base URL of the backend (Express). Leave UNSET in production:
# the API runs same-origin as Vercel functions inside this project.
# Set only for local dev against the standalone backend, or a Railway API.
# VITE_API_URL=http://localhost:4000
# Supabase (browser-safe ANON key only — never the service-role key)
VITE_SUPABASE_URL=https://vamwyouzculrmxlxqkwe.supabase.co
VITE_SUPABASE_ANON_KEY=
# Stripe publishable key (browser-safe) — enables the card form at checkout
VITE_STRIPE_PUBLISHABLE_KEY=
