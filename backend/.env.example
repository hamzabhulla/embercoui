# Ember & Co. backend environment — copy to .env and fill in. NEVER commit .env.
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Supabase (server-side). Service role key must NEVER reach the frontend.
SUPABASE_URL=https://vamwyouzculrmxlxqkwe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Stripe (server-side). Without these, payment endpoints return 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
