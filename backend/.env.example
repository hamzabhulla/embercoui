# Ember & Co. backend environment — copy to .env and fill in. NEVER commit .env.
PORT=4000
NODE_ENV=development
# Proxy hops to trust for X-Forwarded-For (drives req.ip, and with it the
# per-visitor rate limits). On Vercel set TRUST_PROXY=1 — the platform
# edge is the one hop in front of the app. Leave unset for direct/local
# deployments. A hop count, never "true".
# TRUST_PROXY=1
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Supabase (server-side). Service role key must NEVER reach the frontend.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Stripe (server-side). Without these, payment endpoints return 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Google Gemini (server-side) — powers Ember AI chat. Free key from Google AI Studio.
# Without it, /api/v1/chat returns 503.
GEMINI_API_KEY=
# Optional: pin ONE Gemini model instead of the built-in fallback chain
# (lib/chat.ts walks gemini-3.5-flash-lite → 3.8 → 3.6 → 2.5, moving on
# when a model name is retired). Leave unset unless you need control.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: this install's own absolute origin. It drives every absolute
# URL the server generates — robots.txt, sitemap.xml, llms.txt and
# llms-full.txt. Unset, it falls back to the demo's origin
# (https://embercoui.vercel.app), so a real install MUST set it to its
# own domain.
# SITE_URL=https://your-domain.example
